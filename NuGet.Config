<?xml version="1.0" encoding="utf-8"?>
<!--
  This repository vendors the small set of Microsoft.IdentityModel assemblies it needs
  (see /lib) instead of restoring them from NuGet, because it was authored in a sandboxed
  environment with no NuGet registry access. See README.md "Offline build note" for the
  full explanation and for what a normal PackageReference-based setup would look like.
  Clearing package sources here just makes that explicit and keeps `dotnet build` from
  trying (and failing) to reach nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
